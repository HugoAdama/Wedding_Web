---
import { weddingData } from '../../data/wedding';
import SectionHeader from '../common/SectionHeader.astro';
import DownloadIcon from '../icons/DownloadIcon.astro';
import BusIcon from '../icons/BusIcon.astro';
---
<section class="seccion" id="plan-b" aria-label="Plan de contingencia y logística">
  <div class="contenedor contenedor--angosto">
    <SectionHeader
      title={weddingData.contingencyPlan.title}
      subtitle={weddingData.contingencyPlan.subtitle}
    />

    <div class="contingencia-caja" data-anim="fade-up">
      <div class="contingencia-intro">
        <p>{weddingData.contingencyPlan.description}</p>
      </div>

      <div class="contingencia-puntos">
        {weddingData.contingencyPlan.items.map((item, idx) => (
          <div class="contingencia-punto" data-anim="fade-up" data-anim-delay={String((idx % 3) + 1)}>
            <div class="contingencia-punto__icono">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            </div>
            <div>
              <h3 class="contingencia-punto__titulo">{item.title}</h3>
              <p class="contingencia-punto__desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="contingencia-descarga" data-anim="scale-up" data-anim-delay="2">
        <div class="contingencia-descarga__info">
          <h4>Guía Oficial del Invitado & Plan B (PDF)</h4>
          <p>Descarga el documento en tu teléfono con mapas, números de emergencia del Wedding Planner y horarios de buses.</p>
        </div>
        <a
          href={weddingData.contingencyPlan.pdfUrl}
          download="Plan-B-Guia-Invitado-Camila-Mateo.pdf"
          class="boton boton--dorado"
          aria-label="Descargar guía y plan B en PDF"
        >
          <DownloadIcon size={18} />
          <span>Descargar Plan B (PDF)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contingencia-caja {
    background: #fff;
    border-radius: var(--radio-md);
    border: 1px solid rgba(184, 167, 140, 0.4);
    box-shadow: var(--sombra-card);
    padding: clamp(1.75rem, 5vw, 2.5rem);
  }

  .contingencia-intro p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--carbon);
    margin-bottom: 2rem;
  }

  .contingencia-puntos {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .contingencia-punto {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px dashed var(--arena);
  }

  .contingencia-punto:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .contingencia-punto__icono {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radio-sm);
    background: rgba(107, 122, 90, 0.1);
    color: var(--oliva-oscuro);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .contingencia-punto__titulo {
    font-size: 1.25rem;
    color: var(--oliva-oscuro);
    margin-bottom: 0.25rem;
  }

  .contingencia-punto__desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: #555;
  }

  .contingencia-descarga {
    background: var(--crema);
    border: 1px solid var(--arena);
    border-radius: var(--radio-sm);
    padding: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .contingencia-descarga__info {
    flex: 1 1 16rem;
  }

  .contingencia-descarga__info h4 {
    font-size: 1.2rem;
    color: var(--oliva-oscuro);
    margin-bottom: 0.25rem;
  }

  .contingencia-descarga__info p {
    margin: 0;
    font-size: 0.85rem;
    color: #666;
  }
</style>
