---
import { weddingData } from '../../data/wedding';
import Countdown from './Countdown.astro';
import AddToCalendar from '../common/AddToCalendar.astro';
import OliveBranch from '../icons/OliveBranch.astro';
import CheckIcon from '../icons/CheckIcon.astro';
import MapPinIcon from '../icons/MapPinIcon.astro';
import CalendarIcon from '../icons/CalendarIcon.astro';
---
<section class="hero" id="inicio" aria-label="Portada de bienvenida">
  <div class="contenedor hero__rejilla">
    <div class="hero__texto">
      <div class="hero__encabezado-sutil" data-anim="fade-in">
        <span class="hero__linea-ornato"></span>
        <p class="hero__aviso">{weddingData.hero.subtitle}</p>
        <span class="hero__linea-ornato"></span>
      </div>

      <h1 class="hero__nombres" data-anim="fade-up" data-anim-delay="1">
        <span>{weddingData.couple.bride}</span>
        <span class="hero__y">&amp;</span>
        <span>{weddingData.couple.groom}</span>
      </h1>

      <div class="hero__metas" data-anim="fade-up" data-anim-delay="2">
        <div class="hero__meta-item">
          <CalendarIcon size={18} class="hero__icono" />
          <p class="hero__fecha">{weddingData.date.display}</p>
        </div>
        <div class="hero__meta-item">
          <MapPinIcon size={18} class="hero__icono" />
          <p class="hero__lugar">{weddingData.date.city}</p>
        </div>
      </div>

      <div class="hero__cuenta-wrapper" data-anim="scale-up" data-anim-delay="3">
        <Countdown targetDate={weddingData.date.iso} />
      </div>

      <div class="hero__cta-grupo" data-anim="fade-up" data-anim-delay="4">
        <a class="boton boton--dorado" href="#rsvp">
          <CheckIcon size={18} />
          <span>Confirmar asistencia</span>
        </a>
        <p class="hero__limite">Fecha límite de confirmación: <strong>{weddingData.date.rsvpDeadline}</strong></p>
      </div>

      <AddToCalendar />
    </div>

    <div class="hero__visual" data-anim="fade-in" data-anim-delay="2">
      <figure class="hero__foto">
        <div class="arco">
          <img
            src={weddingData.hero.image}
            alt={weddingData.hero.imageAlt}
            width="800"
            height="1000"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <div class="hero__olivo hero__olivo--izq" aria-hidden="true">
          <OliveBranch width="90" height="150" />
        </div>
        <div class="hero__olivo hero__olivo--der" aria-hidden="true">
          <OliveBranch width="90" height="150" />
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3.5rem, 7vw, 5.5rem);
    overflow: hidden;
    position: relative;
    background: radial-gradient(circle at 80% 20%, rgba(232, 220, 200, 0.45) 0%, transparent 60%);
  }

  .hero__rejilla {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  .hero__texto {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__encabezado-sutil {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .hero__linea-ornato {
    display: inline-block;
    width: 2rem;
    height: 1px;
    background-color: var(--terracota);
    opacity: 0.6;
  }

  .hero__aviso {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-style: italic;
    font-size: 1.45rem;
    color: var(--terracota-oscuro);
    letter-spacing: 0.04em;
  }

  .hero__nombres {
    font-family: var(--fuente-script);
    font-weight: 400;
    font-size: clamp(3.8rem, 13vw, 7.2rem);
    line-height: 1.05;
    color: var(--oliva-oscuro);
    margin: 0.2rem 0 0.8rem;
    text-shadow: 0 2px 10px rgba(74, 87, 64, 0.05);
  }

  .hero__y {
    display: inline-block;
    margin-inline: 0.08em;
    color: var(--terracota);
    font-size: 0.85em;
  }

  .hero__metas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem 2rem;
    margin-bottom: 2rem;
  }

  .hero__meta-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--oliva-oscuro);
  }

  .hero__icono {
    color: var(--dorado-oscuro);
  }

  .hero__fecha {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 600;
    color: var(--carbon);
  }

  .hero__lugar {
    margin: 0;
    font-size: 1.05rem;
    color: var(--oliva);
    font-weight: 500;
  }

  .hero__cuenta-wrapper {
    margin-bottom: 2rem;
  }

  .hero__cta-grupo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .hero__limite {
    margin: 0;
    font-size: 0.88rem;
    color: var(--oliva-oscuro);
  }

  .hero__limite strong {
    color: var(--terracota-oscuro);
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__foto {
    position: relative;
    width: min(100%, 23rem);
    margin: 0 auto;
  }

  .arco {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px 0 0;
    overflow: hidden;
    background: var(--arena);
    box-shadow: var(--sombra-elevada);
  }

  .arco img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Arco con ribete exterior dorado */
  .hero__foto::before {
    content: "";
    position: absolute;
    inset: -14px -14px 0;
    border: 1.5px solid var(--dorado);
    border-bottom: 0;
    border-radius: 999px 999px 0 0;
    pointer-events: none;
  }

  .hero__olivo {
    position: absolute;
    bottom: -1rem;
    color: var(--oliva);
    pointer-events: none;
    z-index: 2;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.08));
  }

  .hero__olivo--izq {
    left: -2.75rem;
    transform: rotate(-14deg);
  }

  .hero__olivo--der {
    right: -2.75rem;
    transform: rotate(14deg) scaleX(-1);
  }

  @media (min-width: 900px) {
    .hero__rejilla {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4.5rem;
    }

    .hero__texto {
      text-align: left;
      align-items: flex-start;
    }

    .hero__encabezado-sutil {
      justify-content: flex-start;
    }

    .hero__metas {
      justify-content: flex-start;
    }

    .hero__cta-grupo {
      align-items: flex-start;
    }

    .hero__foto {
      width: 100%;
      max-width: 27rem;
    }
  }

  /* Animación suave al cargar */
  @keyframes aparecerHero {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__texto,
  .hero__visual {
    animation: aparecerHero 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero__visual {
    animation-delay: 0.15s;
  }
</style>
