---
interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
  orientation?: 'vertical' | 'horizontal';
}

const {
  class: className = '',
  width = 80,
  height = 140,
  orientation = 'vertical',
} = Astro.props;
---
<svg
  class={className}
  width={width}
  height={height}
  viewBox="0 0 120 220"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M60 215 C 55 160, 70 100, 62 10"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
  />
  <g fill="currentColor">
    <ellipse cx="42" cy="185" rx="9" ry="20" transform="rotate(-35 42 185)" />
    <ellipse cx="78" cy="165" rx="9" ry="20" transform="rotate(35 78 165)" />
    <ellipse cx="42" cy="140" rx="9" ry="20" transform="rotate(-35 42 140)" />
    <ellipse cx="80" cy="118" rx="9" ry="20" transform="rotate(35 80 118)" />
    <ellipse cx="46" cy="92" rx="8" ry="18" transform="rotate(-35 46 92)" />
    <ellipse cx="80" cy="70" rx="8" ry="18" transform="rotate(35 80 70)" />
    <ellipse cx="50" cy="46" rx="7" ry="15" transform="rotate(-30 50 46)" />
    <ellipse cx="70" cy="22" rx="6" ry="13" transform="rotate(25 70 22)" />
  </g>
</svg>
