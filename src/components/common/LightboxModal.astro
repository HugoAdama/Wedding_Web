---
// Componente modal Lightbox reutilizable para visualización de fotos a pantalla completa
---

<dialog id="galeria-lightbox" class="lightbox" aria-label="Visor de fotos en tamaño completo">
  <div class="lightbox__backdrop" id="lightbox-backdrop"></div>
  <div class="lightbox__contenido">
    <button type="button" class="lightbox__btn lightbox__btn--cerrar" id="btn-lightbox-cerrar" aria-label="Cerrar visor de fotos">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <button type="button" class="lightbox__btn lightbox__btn--nav lightbox__btn--prev" id="btn-lightbox-prev" aria-label="Foto anterior">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="lightbox__marco">
      <img id="lightbox-img" src="" alt="" class="lightbox__imagen" />
      <div class="lightbox__pie">
        <span id="lightbox-contador" class="lightbox__contador">1 / 1</span>
        <p id="lightbox-texto" class="lightbox__texto"></p>
      </div>
    </div>

    <button type="button" class="lightbox__btn lightbox__btn--nav lightbox__btn--next" id="btn-lightbox-next" aria-label="Siguiente foto">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</dialog>

<script>
  import { weddingData } from '../../data/wedding';

  const fotos = weddingData.gallery;
  const dialog = document.getElementById('galeria-lightbox') as HTMLDialogElement | null;
  const imgEl = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const textoEl = document.getElementById('lightbox-texto');
  const contadorEl = document.getElementById('lightbox-contador');
  const backdrop = document.getElementById('lightbox-backdrop');
  const btnCerrar = document.getElementById('btn-lightbox-cerrar');
  const btnPrev = document.getElementById('btn-lightbox-prev');
  const btnNext = document.getElementById('btn-lightbox-next');
  const triggers = document.querySelectorAll('[data-lightbox-trigger]');

  let indiceActual = 0;

  const actualizarFoto = (index: number) => {
    if (!fotos[index] || !imgEl) return;
    indiceActual = (index + fotos.length) % fotos.length;
    const foto = fotos[indiceActual];

    imgEl.src = foto.src;
    imgEl.alt = foto.alt;
    if (textoEl) textoEl.textContent = foto.alt;
    if (contadorEl) contadorEl.textContent = `${indiceActual + 1} / ${fotos.length}`;
  };

  const abrirLightbox = (index: number) => {
    if (!dialog) return;
    actualizarFoto(index);
    dialog.showModal();
    document.body.style.overflow = 'hidden';
  };

  const cerrarLightbox = () => {
    if (!dialog) return;
    dialog.close();
    document.body.style.overflow = '';
  };

  triggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-index') || 0);
      abrirLightbox(idx);
    });
  });

  btnCerrar?.addEventListener('click', cerrarLightbox);
  backdrop?.addEventListener('click', cerrarLightbox);

  btnPrev?.addEventListener('click', () => actualizarFoto(indiceActual - 1));
  btnNext?.addEventListener('click', () => actualizarFoto(indiceActual + 1));

  window.addEventListener('keydown', (e) => {
    if (!dialog?.open) return;
    if (e.key === 'Escape') cerrarLightbox();
    if (e.key === 'ArrowLeft') actualizarFoto(indiceActual - 1);
    if (e.key === 'ArrowRight') actualizarFoto(indiceActual + 1);
  });
</script>

<style>
  .lightbox {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    position: fixed;
    inset: 0;
    z-index: 999;
  }

  .lightbox::backdrop {
    background: rgba(18, 24, 15, 0.88);
    backdrop-filter: blur(12px);
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  .lightbox__contenido {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    pointer-events: none;
  }

  .lightbox__marco {
    position: relative;
    max-width: min(90vw, 760px);
    max-height: 82vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: auto;
    background: #1B2316;
    border: 1.5px solid var(--dorado);
    border-radius: var(--radio-md);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 30px rgba(201, 169, 97, 0.2);
  }

  .lightbox__imagen {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
    display: block;
  }

  .lightbox__pie {
    width: 100%;
    padding: 0.9rem 1.25rem;
    background: #141A10;
    border-top: 1px solid rgba(201, 169, 97, 0.3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--crema);
  }

  .lightbox__contador {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--dorado);
    background: rgba(201, 169, 97, 0.15);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radio-full);
  }

  .lightbox__texto {
    margin: 0;
    font-size: 0.88rem;
    color: var(--crema);
    text-align: right;
  }

  .lightbox__btn {
    pointer-events: auto;
    position: absolute;
    background: rgba(45, 56, 37, 0.85);
    color: var(--crema);
    border: 1px solid var(--dorado);
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4);
    z-index: 10;
  }

  .lightbox__btn:hover {
    background: var(--dorado);
    color: #1a2215;
    transform: scale(1.08);
  }

  .lightbox__btn--cerrar {
    top: 1.5rem;
    right: 1.5rem;
  }

  .lightbox__btn--prev {
    left: clamp(1rem, 3vw, 2.5rem);
  }

  .lightbox__btn--next {
    right: clamp(1rem, 3vw, 2.5rem);
  }

  @media (max-width: 640px) {
    .lightbox__btn--prev {
      left: 0.5rem;
      width: 2.5rem;
      height: 2.5rem;
    }
    .lightbox__btn--next {
      right: 0.5rem;
      width: 2.5rem;
      height: 2.5rem;
    }
    .lightbox__btn--cerrar {
      top: 0.75rem;
      right: 0.75rem;
      width: 2.5rem;
      height: 2.5rem;
    }
    .lightbox__pie {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
    .lightbox__texto {
      text-align: left;
    }
  }
</style>
