---
import { weddingData } from '../../data/wedding';
---

<!-- Reproductor Musical Flotante Ambiental -->
<div class="reproductor-flotante" id="reproductor-boda" aria-label="Reproductor de música ambiental de la boda">
  <button
    type="button"
    class="reproductor-btn"
    id="btn-reproductor-toggle"
    aria-label="Reproducir música de la boda: Harvest Moon de Neil Young"
    title="Reproducir música de la boda"
  >
    <div class="reproductor-vinilo" id="icono-vinilo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <circle cx="12" cy="12" r="10"></circle>
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
      </svg>
    </div>

    <div class="reproductor-info">
      <span class="reproductor-titulo">{weddingData.couple.song.title}</span>
      <span class="reproductor-artista">{weddingData.couple.song.artist}</span>
    </div>

    <div class="reproductor-ecualizador" id="ecualizador-ondas">
      <span class="onda"></span>
      <span class="onda"></span>
      <span class="onda"></span>
    </div>
  </button>
</div>

<script>
  import { MelodiaBoda } from '../../utils/audioSynth';

  const melodia = new MelodiaBoda();
  const btn = document.getElementById('btn-reproductor-toggle');

  const reproductorBox = document.getElementById('reproductor-boda');

  if (btn && reproductorBox) {
    btn.addEventListener('click', () => {
      if (melodia.estaReproduciendo()) {
        melodia.detener();
        reproductorBox.classList.remove('reproductor--activo');
        btn.setAttribute('aria-label', 'Reproducir música de la boda: Harvest Moon');
      } else {
        melodia.iniciar();
        reproductorBox.classList.add('reproductor--activo');
        btn.setAttribute('aria-label', 'Pausar música de la boda');
      }
    });
  }
</script>

<style>
  .reproductor-flotante {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 85;
    transition: transform 0.3s ease;
  }

  .reproductor-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(46, 56, 39, 0.94);
    color: var(--crema);
    border: 1.5px solid var(--dorado);
    border-radius: var(--radio-full);
    padding: 0.5rem 1rem 0.5rem 0.55rem;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
    transition: all 0.25s ease;
  }

  .reproductor-btn:hover {
    transform: translateY(-2px);
    background: rgba(35, 44, 29, 0.98);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.4), 0 0 14px rgba(201, 169, 97, 0.4);
  }

  .reproductor-vinilo {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: rgba(201, 169, 97, 0.2);
    color: var(--dorado);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  /* Animación de giro del disco al reproducir */
  .reproductor--activo .reproductor-vinilo {
    animation: girarVinilo 4s linear infinite;
    color: #fff;
    background: var(--dorado);
  }

  @keyframes girarVinilo {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .reproductor-info {
    display: flex;
    flex-direction: column;
    text-align: left;
    max-width: 9rem;
  }

  .reproductor-titulo {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--crema);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .reproductor-artista {
    font-size: 0.7rem;
    color: var(--arena);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Ecualizador animado */
  .reproductor-ecualizador {
    display: flex;
    align-items: flex-end;
    gap: 2.5px;
    height: 14px;
    margin-left: 0.25rem;
  }

  .onda {
    width: 2.5px;
    height: 4px;
    background: var(--dorado);
    border-radius: 1px;
    transition: height 0.2s ease;
  }

  .reproductor--activo .onda:nth-child(1) {
    animation: ondaAnim 0.7s ease-in-out infinite alternate;
  }
  .reproductor--activo .onda:nth-child(2) {
    animation: ondaAnim 0.9s ease-in-out infinite alternate 0.2s;
  }
  .reproductor--activo .onda:nth-child(3) {
    animation: ondaAnim 0.6s ease-in-out infinite alternate 0.4s;
  }

  @keyframes ondaAnim {
    0% { height: 3px; }
    100% { height: 14px; }
  }

  @media (max-width: 600px) {
    .reproductor-flotante {
      bottom: 1rem;
      left: 1rem;
    }
    .reproductor-info {
      max-width: 7rem;
    }
  }
</style>
