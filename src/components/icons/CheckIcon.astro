---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = '', size = 20 } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <polyline points="20 6 9 17 4 12" />
</svg>
