---
interface Props {
  class?: string;
  size?: number | string;
  direction?: 'down' | 'right' | 'up';
}

const { class: className = '', size = 18, direction = 'down' } = Astro.props;

const rotation = direction === 'right' ? '-90deg' : direction === 'up' ? '180deg' : '0deg';
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  style={`transform: rotate(${rotation}); transition: transform 0.25s ease;`}
  aria-hidden="true"
  focusable="false"
>
  <polyline points="6 9 12 15 18 9" />
</svg>
