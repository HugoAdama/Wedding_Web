---
import '../styles/global.css';
import { weddingData } from '../data/wedding';
import AudioPlayer from '../components/common/AudioPlayer.astro';
import ThemeSwitcher from '../components/common/ThemeSwitcher.astro';
import { getAssetPath } from '../utils/path';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${weddingData.couple.bride} & ${weddingData.couple.groom} · Nos casamos el ${weddingData.date.display}`,
  description = `${weddingData.couple.bride} y ${weddingData.couple.groom} se casan el ${weddingData.date.display} en ${weddingData.date.city}. Mira los detalles de la ceremonia, recepción y confirma tu asistencia.`,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const ogImageUrl = `${siteUrl}${getAssetPath('/images/og-image.webp')}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Privacidad: No indexar en motores de búsqueda -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph para vista previa en WhatsApp y redes -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${weddingData.couple.bride} & ${weddingData.couple.groom} · Nos casamos`} />
    <meta property="og:description" content={`${weddingData.date.display} · ${weddingData.date.city}. Confirma tu asistencia antes del ${weddingData.date.rsvpDeadline}.`} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_PE" />

    <!-- Favicon SVG moderno y Apple Touch Icon -->
    <link rel="icon" href={getAssetPath('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={getAssetPath('/favicon.svg')} />

    <!-- Google Fonts optimizado -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Great+Vibes&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Barra de progreso dorada superior -->
    <div id="scroll-progress-bar" class="scroll-progress-bar" role="progressbar" aria-label="Progreso de lectura" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>

    <a class="saltar" href="#inicio">Saltar al contenido principal</a>
    <slot />

    <!-- Mejoras interactivas: Reproductor de música & Selector de paletas en vivo -->
    <AudioPlayer />
    <ThemeSwitcher />

    <noscript>
      <style>
        [data-anim] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <script>
      // Observador de revelado para animaciones al hacer scroll
      const inicializarAnimaciones = () => {
        const elementos = document.querySelectorAll('[data-anim]');
        if (!elementos.length) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          elementos.forEach((el) => el.classList.add('anim-activo'));
          return;
        }

        const observador = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('anim-activo');
                obs.unobserve(entry.target);
              }
            });
          },
          {
            rootMargin: '0px 0px -30px 0px',
            threshold: 0.12,
          }
        );

        elementos.forEach((el) => observador.observe(el));
      };

      // Barra de progreso de lectura
      const inicializarBarraProgreso = () => {
        const barra = document.getElementById('scroll-progress-bar');
        if (!barra) return;

        const actualizarProgreso = () => {
          const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
          if (scrollTotal <= 0) {
            barra.style.width = '0%';
            return;
          }
          const porcentaje = Math.min(100, Math.max(0, (window.scrollY / scrollTotal) * 100));
          barra.style.width = `${porcentaje}%`;
          barra.setAttribute('aria-valuenow', String(Math.round(porcentaje)));
        };

        window.addEventListener('scroll', actualizarProgreso, { passive: true });
        actualizarProgreso();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          inicializarAnimaciones();
          inicializarBarraProgreso();
        });
      } else {
        inicializarAnimaciones();
        inicializarBarraProgreso();
      }
    </script>
  </body>
</html>
